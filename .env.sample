# =============================================================================
# TagBasedVideoManager 環境変数設定サンプル (.env.sample)
# =============================================================================
# 使い方:
#   このファイルをコピーしてプロジェクトルートに `.env` を作成し、
#   ご利用の環境（Windows / Linux / DevContainer）に合わせてコメントを解除・編集してください。
#
#   PowerShell: Copy-Item .env.sample .env
#   Bash:       cp .env.sample .env
# =============================================================================


# -----------------------------------------------------------------------------
# 【パターン1】Windows ホスト環境 (ローカル実行 / scripts/deploy.ps1 / Renamer)
# -----------------------------------------------------------------------------
# ※ scripts/deploy.ps1 実行時は Windows パス (C:\... 等) が自動的に WSL パス (/mnt/c/...) へ変換されます。
# PORT=5620
# VIDEO_DIR=C:\Users\YourUserName\Videos
# THUMBNAIL_DIR=D:\TagBasedVideoManagerData\thumbnails
# DATABASE_PATH=D:\TagBasedVideoManagerData\metadata.db


# -----------------------------------------------------------------------------
# 【パターン2】Linux ホスト環境 (ローカル実行 / scripts/deploy.sh)
# -----------------------------------------------------------------------------
# PORT=5620
# VIDEO_DIR=/home/your-username/Videos
# THUMBNAIL_DIR=/home/your-username/TagBasedVideoManagerData/thumbnails
# DATABASE_PATH=/home/your-username/TagBasedVideoManagerData/metadata.db


# -----------------------------------------------------------------------------
# 【パターン3】VS Code DevContainer 開発環境 (Linux コンテナ内)
# -----------------------------------------------------------------------------
# ※ 本番コンテナ (5620) とのポート競合を避けるため、PORT=5621 を指定します。
# ※ リポジトリルートはコンテナ内の `/workspaces/TagBasedVideoManager` にマウントされます。
# ※ ホストの動画フォルダ (例: E:\e) は `.devcontainer/devcontainer.json` の `mounts` 設定により
#    コンテナ内の `/app/videos` に読み取り専用マウントされます。
PORT=5621
VIDEO_DIR=/app/videos
THUMBNAIL_DIR=/workspaces/TagBasedVideoManager/test/thumbnails
DATABASE_PATH=/workspaces/TagBasedVideoManager/test/video_manager.db


# -----------------------------------------------------------------------------
# 【共通オプション】AI File Renamer (デスクトップコンパニオンアプリ) 用設定
# -----------------------------------------------------------------------------
# OpenRouter API キー (未設定時は AI 短縮提案を行わず安全に起動します)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# 使用する LLM モデル (省略時の既定値: google/gemini-2.0-flash-lite-preview-02-05:free)
OPENROUTER_MODEL=google/gemini-2.0-flash-lite-preview-02-05:free

# 長パス抽出・警告の閾値文字数 (省略時の既定値: 240)
PATH_LENGTH_THRESHOLD=240
